{
  "Name": "debian-12-arm64",
  "Project": "gce-image-builder",
  "Zone": "us-central1-b",
  "Vars": {
    "build_date": {
      "Value": "${TIMESTAMP}",
      "Description": "Build datestamp used to version the image."
    },
    "builder_machine_type": {
      "Value": "c4a-standard-4",
      "Description": "The machine type to use during build."
    },
    "builder_disk_type": {
      "Value": "hyperdisk-balanced",
      "Description": "The disk type to use during build."
    },
    "builder_disk_name": {
      "Value": "disk_export_hyperdisk",
      "Description": "The name of the export disk."
    },
    "google_cloud_repo": {
      "Value": "DEPRECATED",
      "Description": "DEPRECATED. Included to ease transition of our pipelines, but not used."
    },
    "workflow_root": {
      "Value": "/workflows",
      "Description": "Root of github workflows, defaults to /workflows in the container."
    },
    "gcs_url": {
      "Required": true,
      "Description": "The GCS path that image raw file exported to."
    },
    "sbom_destination": {
      "Value": "${OUTSPATH}/export-image.sbom.json",
      "Description": "SBOM final export destination, copies in place by default"
    },
    "sbom_util_gcs_root": {
      "Value": "",
      "Description": "The root gcs bucket for sbomutil, if using sbomutil to generate the SBOM."
    },
    "sha256_txt": {
       "Value": "${OUTSPATH}/export-image-shasum.txt",
       "Description": "The file where the sha256 sum is stored."
    }
  },
  "Steps": {
    "build": {
      "TimeOut": "60m",
      "IncludeWorkflow": {
        "Path": "${workflow_root}/image_build/debian/debian_12_arm64.wf.json",
        "Vars": {
          "build_date": "${build_date}",
          "builder_machine_type": "${builder_machine_type}"
        }
      }
    },
    "create-disk": {
      "CreateDisks": [
        {
          "Name": "disk-debian-12",
          "SourceImage": "debian-12-arm64-v${build_date}",
          "SizeGb": "10",
          "Type": "${builder_disk_type}"
        }
      ]
    },
    "export-image": {
      "Timeout": "60m",
      "IncludeWorkflow": {
        "Path": "${workflow_root}/export/${builder_disk_name}.wf.json",
        "Vars": {
          "destination": "${gcs_url}",
          "sbom_destination": "${sbom_destination}",
          "source_disk": "disk-debian-12",
          "sbom_util_gcs_root": "${sbom_util_gcs_root}",
          "sha256_txt": "${sha256_txt}"
        }
      }
    },
    "cleanup-image": {
      "DeleteResources": {
        "Images": ["debian-12-arm64-v${build_date}"]
      }
    }
  },
  "Dependencies": {
    "create-disk": ["build"],
    "export-image": ["create-disk"],
    "cleanup-image": ["export-image"]
  }
}
