{
  "Name": "build-debian-12-fai",
  "Vars": {
    "build_date": {
      "Value": "${DATE}",
      "Description": "Build datestamp used to version the image."
    },
    "builder_machine_type": {
      "Value": "e2-standard-4",
      "Description": "The machine type to use during build."
    },
    "builder_disk_type": {
      "Value": "pd-ssd",
      "Description": "The disk type to use during build."
    },
    "publish_project": {
      "Value": "${PROJECT}",
      "Description": "A project to publish the resulting image to."
    }
  },
  "Steps": {
    "build": {
      "Timeout": "60m",
      "IncludeWorkflow": {
        "Path": "./debian_fai.wf.json",
        "Vars": {
          "build_date": "${build_date}",
          "builder_machine_type": "${builder_machine_type}",
          "builder_disk_type": "${builder_disk_type}",
          "debian_version": "bookworm"
        }
      }
    },
    "copy-gcs-object": {
      "CopyGCSObjects": [
        {
          "Source": "${OUTSPATH}/root.tar.gz",
          "Destination": "${OUTSPATH}/root.tar.gz"
        }
      ]
    },
    "create-image": {
      "CreateImages": [
        {
          "Name": "debian-12-v${build_date}",
          "RawDisk": {
            "Source": "${OUTSPATH}/root.tar.gz"
          },
          "Description": "Debian, Debian GNU/Linux, 12 (bookworm), amd64 built on ${build_date}",
          "Family": "debian-12",
          "Project": "${publish_project}",
          "NoCleanup": true,
          "ExactName": true,
          "GuestOsFeatures": ["UEFI_COMPATIBLE", "VIRTIO_SCSI_MULTIQUEUE", "GVNIC"],
          "Licenses": [
            "projects/debian-cloud/global/licenses/debian-12-bookworm"
          ]
        }
      ]
    }
  },
  "Dependencies": {
    "copy-gcs-object": ["build"],
    "create-image": ["copy-gcs-object"]
  }
}
